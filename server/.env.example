# ─────────────────────────────────────────────────────────────
# HotelPro API — environment variables (copy to .env and fill in)
# Never commit .env. Every value here is a placeholder.
# ─────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development
# Render injects PORT automatically in production.
PORT=5001

# MongoDB Atlas connection string (Database → Connect → Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/hotelpro?retryWrites=true&w=majority

# Long random secret (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# The frontend origin (used for CORS, CSRF origin checks and links in emails).
CLIENT_URL=http://localhost:5173
# Optional extra allowed origins, comma separated (e.g. a Vercel preview URL).
CORS_ORIGINS=
# Public URL of this API (informational; used in docs/logs).
API_PUBLIC_URL=http://localhost:5000

# Cookie SameSite: "lax" when the frontend proxies /api through Vercel (recommended);
# "none" only if the browser calls the Render URL directly from another site.
COOKIE_SAMESITE=lax

# ── Payments ────────────────────────────────────────────────
# "mock" = local test mode, no money moves (refused when NODE_ENV=production)
# "razorpay" = Razorpay (use rzp_test_ keys while developing)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid reservation holds its room.
BOOKING_HOLD_MINUTES=15

# ── Email (Nodemailer SMTP). Leave blank to log emails instead of sending them. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=HotelPro <no-reply@example.com>

# ── Image storage (Cloudinary). Leave blank in development to store uploads in server/uploads. ──
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=hotelpro

# Number of proxies in front of Express (used for client IPs in rate limiting).
# Local: 1. Render behind Vercel's /api rewrite: 2 (Vercel edge + Render load balancer).
TRUST_PROXY=1

# Calendar dates ("today", arrivals, analytics days) are computed in this timezone.
HOTEL_TIMEZONE=Asia/Kolkata

# Password used by `npm run seed` for every demo account (development only).
# If empty, a random password is generated and printed.
SEED_DEMO_PASSWORD=
