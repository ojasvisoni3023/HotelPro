{
  "name": "hotelpro-server",
  "version": "1.0.0",
  "private": true,
  "description": "HotelPro REST API (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
