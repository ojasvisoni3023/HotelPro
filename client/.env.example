# ─────────────────────────────────────────────────────────────
# HotelPro frontend — public build-time configuration only.
# Anything prefixed VITE_ is embedded in the JavaScript bundle and visible
# to every visitor: NEVER put secrets (DB URLs, JWT secrets, API secret keys) here.
# ─────────────────────────────────────────────────────────────

# Base URL for API calls. Keep "/api" (recommended): Vite proxies it in development
# and vercel.json rewrites it to the Render backend in production.
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server forwards /api requests.
DEV_API_PROXY=http://localhost:5000
